# Google OAuth2 credentials — thay bằng credentials thật từ Google Cloud Console.
# (EN: Google OAuth2 credentials — replace with real credentials from Google Cloud Console.)
PORT=4000
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:4000/auth/google/callback/real
MOCK_GOOGLE=true
POSTGRES_HOST=localhost
POSTGRES_PORT=5434
POSTGRES_USER=starci_user
POSTGRES_PASSWORD=starci_password
POSTGRES_DB=starci_db
JWT_ACCESS_SECRET=starci_access_secret
JWT_EXPIRES_IN=15m
SEED_ADMIN_EMAIL=admin@demo.com
SEED_ADMIN_PASSWORD=Admin1234!
